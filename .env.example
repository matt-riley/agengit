# agit environment variables (all optional). Copy and customize as needed.

# Disable directory fsync for durability (tests/benchmarks only). Default: on.
# AGIT_FSYNC=0

# Lock acquisition timeout in milliseconds. Default: 10000.
# AGIT_LOCK_TIMEOUT_MS=10000

# Maximum hook payload size in bytes. Default: 16777216 (16 MiB).
# AGIT_HOOK_MAX_BYTES=16777216

# Per-file snapshot size cap in bytes. Default: 16777216 (16 MiB).
# AGIT_MAX_FILE_BYTES=16777216

# S3-compatible remote credentials. The env var *names* are configurable per
# remote in .agit/config.json (access_key_env / secret_key_env /
# session_token_env / encryption_secret_env); these are the defaults.
# AGIT_REMOTE_ACCESS_KEY=
# AGIT_REMOTE_SECRET_KEY=
# AGIT_REMOTE_SESSION_TOKEN=
# AGIT_REMOTE_ENCRYPTION_SECRET=

# TEST ONLY: intentionally crash mid hook-install/uninstall to exercise ADR
# 006's atomic config writes. The original config is preserved by design; this
# only leaves an orphan .agit-tmp- file. Used by the crash-injection tests.
# AGIT_CRASH_AFTER=tmp_write

# Test harness only: overwrite e2e golden files during the run. Not read by the
# released binary.
# AGIT_UPDATE_GOLDEN=1
